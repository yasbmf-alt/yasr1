# Copie para .env.local (só no seu computador) ou cadastre na Cloudflare Pages /
# Vercel em "Environment variables". Os dois valores ficam em
# Supabase → Project Settings → API.
#
# A chave "anon public" pode ficar no site: quem protege seus dados são as
# políticas de acesso do banco (supabase/schema.sql). NUNCA use aqui a chave
# "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
