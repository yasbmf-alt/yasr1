{
  "name": "yas-r1",
  "version": "3.0.0",
  "description": "Yas R1 · cantinho de estudos para a residência",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_TARGET=web vite",
    "typecheck": "tsc -p .",
    "build": "npm run build:web",
    "build:web": "tsc -p . && VITE_TARGET=web vite build",
    "build:claude": "tsc -p . && vite build && python3 scripts/claude-fragment.py dist/index.html yas-r1.html",
    "test": "node scripts/test-backup.mjs && node scripts/test-schema.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  },
  "private": true
}
